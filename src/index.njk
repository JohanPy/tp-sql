    margin-left: 0;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('tpSearchInput');
  const clearBtn = document.getElementById('clearSearchBtn');
  const expandAllBtn = document.getElementById('expandAllBtn');
  const collapseAllBtn = document.getElementById('collapseAllBtn');
  const tpDetailsList = document.querySelectorAll('.tp-details');
  const noResultsMsg = document.getElementById('noResultsMessage');

  // Mémorisation de l'état ouvert/fermé des TPs (ouvert par défaut)
  const STORAGE_KEY = 'sql_tp_details_state_v3';
  try {
    const savedState = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    tpDetailsList.forEach(det => {
      const tpNum = det.getAttribute('data-tp');
      if (savedState[tpNum] !== undefined) {
        det.open = savedState[tpNum];
      } else {
        det.open = true; // Ouvert par défaut
      }
      det.addEventListener('toggle', () => {
        savedState[tpNum] = det.open;
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(savedState));
        } catch (e) {}
      });
    });
  } catch (e) {
    tpDetailsList.forEach(det => det.open = true);
  }

  // Recherche en temps réel
  function filterExercises(query) {
    const q = query.trim().toLowerCase();
    clearBtn.style.display = q ? 'block' : 'none';

    let totalVisible = 0;

    tpDetailsList.forEach(details => {
      const tpNum = details.getAttribute('data-tp');
      const titleEl = details.querySelector('.tp-title');
      const tpTitle = titleEl ? titleEl.textContent.toLowerCase() : '';
      const dbEl = details.querySelector('.db-tag span');
      const dbName = dbEl ? dbEl.textContent.toLowerCase() : '';
      
      const cards = details.querySelectorAll('.exercise-card-mini');
      let visibleInTp = 0;

      cards.forEach(card => {
        const cardTitle = card.getAttribute('data-title') || card.textContent.toLowerCase();
        const matches = !q || cardTitle.includes(q) || tpTitle.includes(q) || dbName.includes(q) || (`tp ${tpNum}`).includes(q) || (`tp${tpNum}`).includes(q);
        
        card.style.display = matches ? 'flex' : 'none';
        if (matches) visibleInTp++;
      });

      if (visibleInTp > 0) {
        details.style.display = '';
        if (q) details.open = true;
        totalVisible += visibleInTp;
      } else {
        details.style.display = 'none';
      }
    });

    if (noResultsMsg) {
      noResultsMsg.style.display = totalVisible === 0 ? 'block' : 'none';
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => filterExercises(e.target.value));
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      filterExercises('');
      searchInput.focus();
    });
  }

  if (expandAllBtn) {
    expandAllBtn.addEventListener('click', () => {
      tpDetailsList.forEach(det => det.open = true);
    });
  }

  if (collapseAllBtn) {
    collapseAllBtn.addEventListener('click', () => {
      tpDetailsList.forEach(det => det.open = false);
    });
  }
});
</script>
