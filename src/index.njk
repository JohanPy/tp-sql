---
layout: base.njk
title: "Accueil - SQL TP"
intitule: "SQL TP - Travaux Pratiques"
permalink: "/"
---

<div class="home-container">
  <!-- En-tête compact et moderne -->
  <div class="hero-compact">
    <div class="hero-main">
      <div class="hero-title-row">
        <span class="hero-icon">🎓</span>
        <div>
          <h1>Plateforme SQL</h1>
          <p class="hero-subtitle">Entraînement interactif sur bases de données relationnelles</p>
        </div>
      </div>
    </div>
    <div class="hero-stats">
      <div class="stat-pill" title="Nombre total d'exercices disponibles">
        <span class="stat-value">{{ collections.allTPs.length }}</span>
        <span class="stat-label">exercices</span>
      </div>
      <div class="stat-pill" title="Bases de données actives (Comptoir2000, Gymnase2000)">
        <span class="stat-value">2</span>
        <span class="stat-label">bases</span>
      </div>
    </div>
  </div>

  <!-- Barre d'outils et de recherche rapide -->
  <div class="tp-toolbar">
    <div class="tp-search-box">
      <svg class="search-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="tpSearchInput" placeholder="Rechercher un TP, un exercice, une notion (ex: JOIN, CASE, date)..." autocomplete="off">
      <button type="button" id="clearSearchBtn" class="clear-search-btn" title="Effacer la recherche" style="display:none;">&times;</button>
    </div>
    <div class="tp-view-actions">
      <button type="button" id="expandAllBtn" class="tool-btn" title="Tout déplier">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="7 13 12 18 17 13"></polyline>
          <polyline points="7 6 12 11 17 6"></polyline>
        </svg>
        <span>Déplier tout</span>
      </button>
      <button type="button" id="collapseAllBtn" class="tool-btn" title="Tout replier">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="17 11 12 6 7 11"></polyline>
          <polyline points="17 18 12 13 7 18"></polyline>
        </svg>
        <span>Replier</span>
      </button>
    </div>
  </div>

  <!-- Liste des TP en accordéon ultra-compact (repliés par défaut) -->
  <div class="tp-list-container" id="tpListContainer">
    {% for tpNumber, tpExercices in collections.tpsByNumber %}
    <details class="tp-details" data-tp="{{ tpNumber }}" open>
      <summary class="tp-summary">
        <div class="tp-header-info">
          <span class="tp-badge">TP {{ tpNumber }}</span>
          <h2 class="tp-title">{{ tpExercices[0].data.intitule | replace("TP " + tpNumber + " — ", "") | replace("TP " + tpNumber + " – ", "") | replace("TP " + tpNumber + " - ", "") }}</h2>
        </div>
        
        <div class="tp-header-meta">
          <!-- Badge BDD avec icône SVG vectorielle propre -->
          <span class="db-tag" title="Base de données : {{ tpExercices[0].data.base | replace('.sqlite', '') }}">
            <svg class="db-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
              <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
              <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
            </svg>
            <span>{{ tpExercices[0].data.base | replace(".sqlite", "") }}</span>
          </span>
          
          <span class="tp-count-badge">{{ tpExercices.length }} ex.</span>

          <span class="chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </div>
      </summary>
      
      <div class="tp-content">
        <div class="exercise-grid">
          {% for exercise in tpExercices %}
          {% set rawNum = exercise.data.exerciceNum %}
          {% set cleanTitle = exercise.data.titre | replace("TP " + tpNumber + " : ", "") | replace("TP " + tpNumber + " — ", "") | replace("TP " + tpNumber + " - ", "") | replace("TP" + tpNumber + " - ", "") | replace("Exercice " + rawNum + " : ", "") | replace("Exercice " + rawNum + " - ", "") %}
          <a href="{{ exercise.url | absUrl }}" class="exercise-card-mini" data-title="{{ cleanTitle | lower }}" data-tp="{{ tpNumber }}">
            <div class="ex-mini-header">
              <span class="ex-badge {% if rawNum == 0 %}ex-badge-intro{% endif %}">
                {% if rawNum == 0 %}Intro{% else %}Ex {{ rawNum }}{% endif %}
              </span>
              <span class="ex-arrow">
                <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
            <div class="ex-title-mini" title="{{ cleanTitle }}">
              {{ cleanTitle }}
            </div>
          </a>
          {% endfor %}
        </div>
      </div>
    </details>
    {% endfor %}
  </div>

  <div id="noResultsMessage" class="no-results-box" style="display: none;">
    <p>🔍 Aucun exercice ne correspond à votre recherche.</p>
  </div>

  <!-- Aide rapide condensée -->
  <div class="quick-help-compact">
    <div class="quick-help-title">
      <div style="display: flex; align-items: center; gap: 5px;">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>Guide express</span>
      </div>
      <button type="button" id="homeTourTrigger" class="quick-help-tour-btn" title="Ouvrir le guide didactique et lancer la visite guidée (?)">
        <span class="tour-btn-mini-icon">?</span>
        <span>Guide didactique</span>
      </button>
    </div>
    <div class="help-steps-compact">
      <div class="step-chip"><span class="step-num">1</span> Choisir un exercice</div>
      <div class="step-sep">›</div>
      <div class="step-chip"><span class="step-num">2</span> Rédiger la requête</div>
      <div class="step-sep">›</div>
      <div class="step-chip"><span class="step-num">3</span> Exécuter <kbd>Ctrl</kbd>+<kbd>Enter</kbd></div>
      <div class="step-sep">›</div>
      <div class="step-chip"><span class="step-num">4</span> Comparer avec le résultat attendu</div>
    </div>
  </div>
</div>

<style>
